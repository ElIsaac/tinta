#!/usr/bin/env python3
"""
spenmouse-manager: icono de Waybar + popup para manejar spen-mouse en la PC.

    spenmouse-manager             abre/cierra el popup
    spenmouse-manager --status    JSON para el modulo custom de Waybar
    spenmouse-manager --selftest  pruebas rapidas sin tocar nada

Maneja el servicio de usuario spenmouse-receiver.service (iniciar, detener,
arranque al iniciar sesion, que pantalla ve el telefono y su escala), el
emparejamiento y el despertar por WiFi de ../wake (via pkexec).
Las opciones del receptor viven en ~/.config/spenmouse/receiver.env, que el
servicio lee como EnvironmentFile.
"""

import ipaddress
import os
import shlex
import signal
import subprocess
import sys

HERE = os.path.dirname(os.path.realpath(__file__))  # ~/.local/bin/spenmouse-manager es un symlink aqui
REPO = os.path.dirname(HERE)
RECEIVER = os.path.join(REPO, "receiver/target/release/spenmouse-receiver")
WAKE_INSTALL = os.path.join(REPO, "wake/install.sh")
WAKE_UNINSTALL = os.path.join(REPO, "wake/uninstall.sh")
WAKE_CONF = "/etc/spenmouse-wake.conf"
WAKE_VARS = ("ND_INTERVAL_MS", "ND_DELAY_S", "WAKE_ON_DISCONNECT", "GRACE_S", "PORT")

UNIT = "spenmouse-receiver.service"
RUNTIME = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
STATUS_FILE = os.path.join(RUNTIME, "spenmouse/status")
PID_FILE = os.path.join(RUNTIME, "spenmouse-manager.pid")
OPTS_FILE = os.path.join(os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
                         "spenmouse/receiver.env")
# SPENMOUSE_ALT (otras IPs de la laptop, separadas por coma) solo lo usa el manager al emparejar
OPTS_DEFAULT = {"SPENMOUSE_SCREEN": "virtual", "SPENMOUSE_SCALE": "1.5", "SPENMOUSE_ALT": ""}
MAX_ALT = 4                   # limite de la app del telefono

VIRTUAL_OUTPUT = "spenmouse"  # nombre del monitor virtual que crea el receptor
WAYBAR_SIGNAL = 11            # debe coincidir con "signal" del modulo en install.sh
MAX_SSID_BYTES = 32
POPUP_WIDTH = 460
POPUP_EDGE_GAP = 8
QR_MODULE_PX = 4
REFRESH_S = 2
ROOT_OUTPUT_LINES = 12

# estado -> (icono Nerd Font, texto)
STATES = {
    "stopped":   ("\U000f037e", "Receptor detenido"),
    "idle":      ("\U000f037d", "En marcha, sin teléfono"),
    "phone":     ("\U000f0121", "Teléfono conectado"),
    "streaming": ("\U000f0119", "Transmitiendo pantalla"),
}


# ── estado ───────────────────────────────────────────────────────────────────

def run(*cmd, timeout=15):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, r.stdout.strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, str(e)


def systemctl(*args):
    return run("systemctl", "--user", *args)


def read_kv(path):
    try:
        with open(path) as f:
            return dict(line.rstrip("\n").split("=", 1) for line in f if "=" in line)
    except OSError:
        return {}


def receiver_state():
    """(estado, ip del telefono, salida transmitida). El archivo de estado queda
    viejo si el servicio no esta activo, por eso se pregunta primero a systemd."""
    if systemctl("is-active", UNIT)[1] != "active":
        return "stopped", "", ""
    kv = read_kv(STATUS_FILE)
    phone, stream = kv.get("phone", ""), kv.get("stream", "")
    return ("streaming" if stream else "phone" if phone else "idle"), phone, stream


def describe(state, phone, stream):
    text = STATES[state][1]
    if state == "streaming":
        text += f" ({stream})"
    if phone:
        text += f" · {phone}"
    return text


def print_status():
    import json
    state, phone, stream = receiver_state()
    print(json.dumps({"text": STATES[state][0], "class": state,
                      "tooltip": "spen-mouse: " + describe(state, phone, stream)},
                     ensure_ascii=False))


def poke_waybar():
    run("pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "-x", "waybar")


# ── opciones del receptor ────────────────────────────────────────────────────

def load_opts(path=OPTS_FILE):
    return {**OPTS_DEFAULT, **{k: v for k, v in read_kv(path).items() if k in OPTS_DEFAULT and v}}


def save_opts(changes, path=OPTS_FILE):
    opts = {**load_opts(path), **changes}
    screen = opts["SPENMOUSE_SCREEN"]
    # systemd parte el EnvironmentFile por lineas y el valor va tal cual a ExecStart
    if not screen or any(c.isspace() or c in "\"'\\$" for c in screen):
        raise ValueError(f"nombre de salida no válido: {screen!r}")
    opts["SPENMOUSE_SCALE"] = f"{float(opts['SPENMOUSE_SCALE']):g}"
    opts["SPENMOUSE_ALT"] = ",".join(str(ipaddress.IPv4Address(a)) for a in split_alt(opts["SPENMOUSE_ALT"]))
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        f.write("".join(f"{k}={opts[k]}\n" for k in OPTS_DEFAULT))
    os.replace(tmp, path)


def split_alt(value):
    return [a for a in value.split(",") if a]


def alt_candidates():
    """[(ip, interfaz)] de esta maquina que el telefono podria usar ademas de la
    principal: fuera la de la ruta por defecto (ya va como host), loopback y
    puentes (docker, libvirt), que no son alcanzables desde fuera."""
    import json
    import socket
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
        s.connect(("1.1.1.1", 9))  # igual que el receptor: solo elige ruta, no manda nada
        main = s.getsockname()[0]
        s.close()
    except OSError:
        main = ""
    found = []
    try:
        for iface in json.loads(run("ip", "-j", "-4", "addr", "show")[1]):
            name = iface["ifname"]
            if os.path.exists(f"/sys/class/net/{name}/bridge"):
                continue
            found += [(a["local"], name) for a in iface["addr_info"]
                      if a.get("scope") == "global" and a["local"] != main]
    except (ValueError, KeyError, TypeError):
        pass
    return found


def outputs():
    import json
    try:
        mons = json.loads(run("hyprctl", "monitors", "-j")[1])
        return [m["name"] for m in mons if m["name"] != VIRTUAL_OUTPUT]
    except (ValueError, KeyError, TypeError):
        return []


# ── emparejar ────────────────────────────────────────────────────────────────

def qr_matrix(text):
    """Convierte el QR de terminal (medios bloques, 2 filas por linea) en una
    matriz de bool, True = modulo oscuro. La esquina es zona de silencio (clara)."""
    rows = []
    for line in text.splitlines():
        if not line or set(line) - set(" ▀▄█"):
            continue
        rows.append([c in "▀█" for c in line])
        rows.append([c in "▄█" for c in line])
    if not rows:
        return []
    light = rows[0][0]
    # el QR es cuadrado: con altura impar sobra media fila de relleno al final
    return [[cell != light for cell in row] for row in rows[:len(rows[0])]]


def pairing(alts=()):
    """(matriz QR, URI, error). La URI lleva la llave: no se guarda ni se registra."""
    cmd = [RECEIVER, "pair"]
    for a in alts:
        cmd += ["--alt", a]
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired) as e:
        return [], "", str(e)
    if r.returncode != 0:
        return [], "", r.stderr.strip() or "falló spenmouse-receiver pair"
    uri = next((l for l in r.stdout.splitlines() if l.startswith("spenmouse://")), "")
    return qr_matrix(r.stdout), uri, ""


# ── despertar por WiFi ───────────────────────────────────────────────────────

def wake_conf(path=WAKE_CONF):
    """None si no esta instalado; si no (ssids, {variable: valor}).
    El archivo lo escribe install.sh con printf %q: solo bash lo lee bien."""
    if not os.path.isfile(path):
        return None
    script = '. "$1" || exit 1; printf "%s\\0" ' + " ".join(f'"${v}"' for v in WAKE_VARS) + ' "${SSIDS[@]}"'
    r = subprocess.run(["bash", "-c", script, "_", path], capture_output=True, text=True)
    parts = r.stdout.split("\0")[:-1]
    if r.returncode != 0 or len(parts) < len(WAKE_VARS):
        return [], {}
    n = len(WAKE_VARS)
    return parts[n:], {k: v for k, v in zip(WAKE_VARS, parts[:n]) if v}


def wake_install_cmd(ssids, keep):
    """Comando exacto que se le muestra al usuario y se ejecuta. `keep` conserva
    los ajustes de una instalacion anterior (install.sh reescribe todo)."""
    env = ["env", *[f"{k}={v}" for k, v in keep.items()]] if keep else []
    return ["pkexec", *env, WAKE_INSTALL, "--", *ssids]


def ssid_error(ssid, current):
    if not ssid:
        return "Escribe el nombre del hotspot"
    if len(ssid.encode()) > MAX_SSID_BYTES or "\0" in ssid or "\n" in ssid:
        return "Un SSID tiene como máximo 32 bytes"
    if ssid in current:
        return "Ese SSID ya está en la lista"
    return None


def wifi():
    """(interfaz, MAC actual, SSID actual) de la primera interfaz WiFi."""
    try:
        for iface in sorted(os.listdir("/sys/class/net")):
            if os.path.exists(f"/sys/class/net/{iface}/phy80211"):
                with open(f"/sys/class/net/{iface}/address") as f:
                    mac = f.read().strip()
                link = run("iw", "dev", iface, "link")[1]
                ssid = next((l.split("SSID:", 1)[1].strip() for l in link.splitlines() if "SSID:" in l), "")
                return iface, mac, ssid
    except OSError:
        pass
    return "", "", ""


def saved_wifi():
    out = run("nmcli", "-t", "-f", "TYPE,NAME", "connection", "show")[1]
    return sorted(l.split(":", 1)[1].replace("\\:", ":") for l in out.splitlines()
                  if l.startswith("802-11-wireless:"))


# ── popup ────────────────────────────────────────────────────────────────────

# Misma paleta y clases que waybar-monitor-manager (Everforest)
CSS = b"""
window#spenmouse-manager { background: transparent; }
box.popup {
